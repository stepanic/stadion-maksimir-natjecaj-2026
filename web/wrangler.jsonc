// Worker sa statičkim datotekama (zamjenjuje Pages projekt stadion-maksimir).
// Deploy: npm run deploy. Pravila usmjeravanja su u worker/index.ts.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maksimir",
  "account_id": "7dc7167b7e2e00923bfa7cd697df14e4", // D.O.M.
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // DNS zapisi (CNAME na Pages) ostaju; ruta zone presreće promet prije origina.
  // Povrat na Pages: ukloni rute i deployaj (ili obriši rute u dashboardu).
  "routes": [
    { "pattern": "maksimir.domovina.ai/*", "zone_name": "domovina.ai" },
    { "pattern": "stadion-maksimir.domovina.ai/*", "zone_name": "domovina.ai" }
  ],
  // Relayer glasanja na lancu (/relayer/<chainId>/…, worker/relayer/route.ts). Mreža radi tek
  // kad postoji i tajna SPONSOR_PRIVATE_KEY_<chainId> (wrangler secret put), inače 503.
  // Lokalno: tajne u web/.dev.vars (gitignorirano).
  "kv_namespaces": [{ "binding": "RELAY_KV", "id": "31e439f4ff6e42238fd94ed372f0cf2b" }], // maksimir-relay
  "vars": {
    "RELAYER_CHAINS": "{\"10200\":{\"contract\":\"0xe7903145c8F2401fC16D78d9788D34beE0c3e029\",\"rpc\":\"https://rpc.chiadochain.net\"}}",
    "RELAYER_ALLOWED_ORIGINS": "http://localhost:5173",
    "MAX_FEE_GWEI": "5",
    "IP_DAILY_LIMIT": "50",
    "GLOBAL_DAILY_LIMIT": "5000"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true }
}
